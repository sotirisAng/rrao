    <!-- http://i-lab.aegean.gr/ontologies/rrao/iccs#iccs_0502 -->

    <owl:Class rdf:about="http://i-lab.aegean.gr/ontologies/rrao/iccs#iccs_0502"/>
    


    <!-- http://i-lab.aegean.gr/ontologies/rrao/iccs#iccs_0601 -->

    <owl:Class rdf:about="http://i-lab.aegean.gr/ontologies/rrao/iccs#iccs_0601"/>
    


    <!-- http://w3id.org/rrao/iccs#iccs_0502 -->

    <owl:Class rdf:about="http://w3id.org/rrao/iccs#iccs_0502"/>
    


    <!-- http://w3id.org/rrao/iccs#iccs_06 -->

    <owl:Class rdf:about="http://w3id.org/rrao/iccs#iccs_06"/>
    


    <!-- http://www.w3.org/ns/odrl/2/Action -->

    <owl:Class rdf:about="http://www.w3.org/ns/odrl/2/Action"/>
    


    <!-- http://www.w3.org/ns/odrl/2/Duty -->

    <owl:Class rdf:about="http://www.w3.org/ns/odrl/2/Duty"/>
    


    <!-- http://www.w3.org/ns/odrl/2/Policy -->

    <owl:Class rdf:about="http://www.w3.org/ns/odrl/2/Policy"/>
    


    <!-- https://w3id.org/rrao#acquittal -->

    <owl:Class rdf:about="https://w3id.org/rrao#acquittal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#wayOfRelease"/>
        <rdfs:comment xml:lang="en">Α judgment that a person is not guilty of the crime with which the person has been charged</rdfs:comment>
        <rdfs:label xml:lang="pt">Absolvição</rdfs:label>
        <rdfs:label xml:lang="en">Αcquittal</rdfs:label>
        <rdfs:label xml:lang="el">Αθώωση</rdfs:label>
        <rdfs:label xml:lang="bg">Оправдателна присъда</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#communityServiceWork -->

    <owl:Class rdf:about="https://w3id.org/rrao#communityServiceWork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#nonCustodialPenalty"/>
        <rdfs:comment xml:lang="en">A penalty that requires the offender to perform unpaid work for the benefit of the community.</rdfs:comment>
        <rdfs:label xml:lang="en">Community Service Work</rdfs:label>
        <rdfs:label xml:lang="pt">Prestação de serviço comunitário</rdfs:label>
        <rdfs:label xml:lang="el">Κοινωφελής εργασία</rdfs:label>
        <rdfs:label xml:lang="bg">Общественополезен труд</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#convictionStatus -->

    <owl:Class rdf:about="https://w3id.org/rrao#convictionStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rrao#debtor"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#detained"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#remand"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#sentenced"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The legal status of an individual while they are convicted.</rdfs:comment>
        <rdfs:label xml:lang="en">Conviction Status</rdfs:label>
        <rdfs:label xml:lang="pt">Situação juridico-penal</rdfs:label>
        <rdfs:label xml:lang="el">Κατάσταση καταδίκης</rdfs:label>
        <rdfs:label xml:lang="bg">Статус на присъдата</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#correctionaiInstitution -->

    <owl:Class rdf:about="https://w3id.org/rrao#correctionaiInstitution">
        <rdfs:comment xml:lang="en">A correctional institution is a facility where individuals are confined and rehabilitated after being convicted of crimes.</rdfs:comment>
        <rdfs:label xml:lang="en">Correctional Institution</rdfs:label>
        <rdfs:label xml:lang="pt">Establecimento prisional</rdfs:label>
        <rdfs:label xml:lang="el">Σωφρονιστικό ίδρυμα</rdfs:label>
        <rdfs:label xml:lang="bg">Място за изтърпяване на наказанието</rdfs:label>
        <rdfs:seeAlso rdf:resource="euvoc:penalInstitution"/>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#court -->

    <owl:Class rdf:about="https://w3id.org/rrao#court">
        <owl:disjointWith rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:comment xml:lang="en">An institution with the authority to adjudicate legal disputes and administer justice.</rdfs:comment>
        <rdfs:label xml:lang="en">Court</rdfs:label>
        <rdfs:label xml:lang="pt">Tribunal</rdfs:label>
        <rdfs:label xml:lang="el">Δικαστήριο</rdfs:label>
        <rdfs:label xml:lang="bg">Съд</rdfs:label>
        <rdfs:seeAlso xml:lang="en">euvoc:courtOfLaw</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#courtDecision -->

    <owl:Class rdf:about="https://w3id.org/rrao#courtDecision">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
        <rdfs:comment xml:lang="en">A formal judgment or ruling made by a court of law.</rdfs:comment>
        <rdfs:label xml:lang="en">Court Decision</rdfs:label>
        <rdfs:label xml:lang="pt">Decisão Judicial</rdfs:label>
        <rdfs:label xml:lang="el">Δικαστική απόφαση</rdfs:label>
        <rdfs:label xml:lang="bg">Съдебно решение</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#crime -->

    <owl:Class rdf:about="https://w3id.org/rrao#crime">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
        <rdfs:comment xml:lang="en">An act that violates the law and is punishable by a legal authority.</rdfs:comment>
        <rdfs:label xml:lang="en">Crime</rdfs:label>
        <rdfs:label xml:lang="pt">Crime</rdfs:label>
        <rdfs:label xml:lang="el">Έγκλημα</rdfs:label>
        <rdfs:label xml:lang="bg">Престъпление</rdfs:label>
        <rdfs:seeAlso rdf:resource="euvoc:offence"/>
        <rdfs:seeAlso rdf:resource="https://www.unodc.org/unodc/en/data-and-analysis/statistics/iccs.html"/>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#custodialPenalty -->

    <owl:Class rdf:about="https://w3id.org/rrao#custodialPenalty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:comment xml:lang="en">A court-ordered punishment that requires the offender to be detained in a secure facility.</rdfs:comment>
        <rdfs:label xml:lang="en">Custodial penalty</rdfs:label>
        <rdfs:label xml:lang="pt">Pena privativa de liberdade</rdfs:label>
        <rdfs:label xml:lang="el">Ποινή στέρησης ελευθερίας</rdfs:label>
        <rdfs:label xml:lang="bg">Наказание с лишаване от свобода</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#custody -->

    <owl:Class rdf:about="https://w3id.org/rrao#custody">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#executionOfPenalty"/>
        <rdfs:label xml:lang="en">Custody</rdfs:label>
        <rdfs:label xml:lang="pt">Detenção</rdfs:label>
        <rdfs:label xml:lang="el">Κράτηση</rdfs:label>
        <rdfs:label xml:lang="bg">Задържане под стража</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#detentionRecord -->

    <owl:Class rdf:about="https://w3id.org/rrao#detentionRecord">
        <rdfs:label xml:lang="en">Detention Record</rdfs:label>
        <rdfs:label xml:lang="pt">Registro de detenção</rdfs:label>
        <rdfs:label xml:lang="el">Εγγραφή κράτησης</rdfs:label>
        <rdfs:label xml:lang="bg">Запис на задържане</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#endOfSentence -->

    <owl:Class rdf:about="https://w3id.org/rrao#endOfSentence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#wayOfRelease"/>
        <rdfs:label xml:lang="en">End of Sentence</rdfs:label>
        <rdfs:label xml:lang="pt">Término da pena</rdfs:label>
        <rdfs:label xml:lang="el">Λήξη ποινής</rdfs:label>
        <rdfs:label xml:lang="bg">Край на присъдата</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#executionOfPenalty -->

    <owl:Class rdf:about="https://w3id.org/rrao#executionOfPenalty">
        <rdfs:comment xml:lang="en">The enforcement or carrying out of a legally imposed punishment.</rdfs:comment>
        <rdfs:label xml:lang="en">Execution of penalty</rdfs:label>
        <rdfs:label xml:lang="pt">Execução da pena</rdfs:label>
        <rdfs:label xml:lang="el">Εκτέλεση ποινής</rdfs:label>
        <rdfs:label xml:lang="bg">Изпълнение на наказанието</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#gravityOfCrime -->

    <owl:Class rdf:about="https://w3id.org/rrao#gravityOfCrime">
        <rdfs:comment xml:lang="en">The seriousness or severity of a criminal act.</rdfs:comment>
        <rdfs:label xml:lang="pt">Gravidade do crime</rdfs:label>
        <rdfs:label xml:lang="en">Gravity of Crime</rdfs:label>
        <rdfs:label xml:lang="el">Βαρύτητα εγκλήματος</rdfs:label>
        <rdfs:label xml:lang="bg">Тежест на престъплението</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#homeDetention -->

    <owl:Class rdf:about="https://w3id.org/rrao#homeDetention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#wayOfRelease"/>
        <rdfs:comment xml:lang="en">A legal penalty where the offender is confined to their home rather than a prison.</rdfs:comment>
        <rdfs:label xml:lang="en">Home detention</rdfs:label>
        <rdfs:label xml:lang="pt">Prisão domiciliária</rdfs:label>
        <rdfs:label xml:lang="el">Κατ’ οίκον περιορισμός</rdfs:label>
        <rdfs:label xml:lang="bg">Домашен арест</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#imprisoned -->

    <owl:Class rdf:about="https://w3id.org/rrao#imprisoned">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:label xml:lang="en">Imprisoned Person</rdfs:label>
        <rdfs:label xml:lang="pt">Indivíduo em reclusão</rdfs:label>
        <rdfs:label xml:lang="el">Κρατούμενος</rdfs:label>
        <rdfs:label xml:lang="bg">Лице, лишено от свобода</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#imprisonment -->

    <owl:Class rdf:about="https://w3id.org/rrao#imprisonment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#custodialPenalty"/>
        <rdfs:comment xml:lang="en">The act of confining an individual in a prison as punishment for a crime.</rdfs:comment>
        <rdfs:label xml:lang="en">Imprisonment</rdfs:label>
        <rdfs:label xml:lang="pt">Pena de prisão</rdfs:label>
        <rdfs:label xml:lang="el">Φυλάκιση</rdfs:label>
        <rdfs:label xml:lang="bg">Лишаване от свобода</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#levelOfParticipation -->

    <owl:Class rdf:about="https://w3id.org/rrao#levelOfParticipation">
        <rdfs:comment xml:lang="en">The degree to which an individual is involved in the commission of a crime.</rdfs:comment>
        <rdfs:label xml:lang="pt">Grau de participação</rdfs:label>
        <rdfs:label xml:lang="en">Level of participation</rdfs:label>
        <rdfs:label xml:lang="el">Επίπεδο συμμετοχής</rdfs:label>
        <rdfs:label xml:lang="bg">Степен на участие</rdfs:label>
        <rdfs:seeAlso rdf:resource="euvoc:complicity"/>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#liability -->

    <owl:Class rdf:about="https://w3id.org/rrao#liability">
        <rdfs:comment xml:lang="en">The legal responsibility for one&apos;s actions or the consequences of a criminal act.</rdfs:comment>
        <rdfs:label xml:lang="en">Liability</rdfs:label>
        <rdfs:label xml:lang="pt">Responsabilidade</rdfs:label>
        <rdfs:label xml:lang="el">Ευθύνη</rdfs:label>
        <rdfs:label xml:lang="bg">Отговорност</rdfs:label>
        <rdfs:seeAlso rdf:resource="euvoc:criminalLiability"/>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#lifeImprisonment -->

    <owl:Class rdf:about="https://w3id.org/rrao#lifeImprisonment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#custodialPenalty"/>
        <rdfs:comment xml:lang="en">A prison sentence that lasts for the remainder of the offender&apos;s life.</rdfs:comment>
        <rdfs:label xml:lang="en">Life Imprisonment</rdfs:label>
        <rdfs:label xml:lang="pt">Pena de prisão perpétua</rdfs:label>
        <rdfs:label xml:lang="el">Ισόβια κάθειρξη</rdfs:label>
        <rdfs:label xml:lang="bg">Доживотен затвор</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#nonCustodialPenalty -->

    <owl:Class rdf:about="https://w3id.org/rrao#nonCustodialPenalty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:label xml:lang="en">Non-custodial penalty</rdfs:label>
        <rdfs:label xml:lang="pt">Pena não privativa de liberdade</rdfs:label>
        <rdfs:label xml:lang="el">Ποινή μη στέρησης ελευθερίας</rdfs:label>
        <rdfs:label xml:lang="bg">Наказание без лишаване от свобода</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#pecuniarySentence -->

    <owl:Class rdf:about="https://w3id.org/rrao#pecuniarySentence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#nonCustodialPenalty"/>
        <rdfs:comment xml:lang="en">A financial penalty imposed as punishment for a crime</rdfs:comment>
        <rdfs:label xml:lang="en">Pecuniary Sentence</rdfs:label>
        <rdfs:label xml:lang="pt">Pena pecuniária</rdfs:label>
        <rdfs:label xml:lang="el">Χρηματική ποινή</rdfs:label>
        <rdfs:label xml:lang="bg">Финансово наказание</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#penalCourt -->

    <owl:Class rdf:about="https://w3id.org/rrao#penalCourt">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#court"/>
        <rdfs:comment xml:lang="en">A court that is responsible for handling criminal cases and offenses.</rdfs:comment>
        <rdfs:label xml:lang="en">Penal court</rdfs:label>
        <rdfs:label xml:lang="pt">Tribunal penal</rdfs:label>
        <rdfs:label xml:lang="el">Ποινικό δικαστήριο</rdfs:label>
        <rdfs:label xml:lang="bg">Наказателен съд</rdfs:label>
        <rdfs:seeAlso xml:lang="en">euvoc:criminalCourt</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#penalty -->

    <owl:Class rdf:about="https://w3id.org/rrao#penalty">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
        <rdfs:comment xml:lang="en">The legal punishment imposed on an individual who has been convicted of a crime.</rdfs:comment>
        <rdfs:label xml:lang="pt">Pena</rdfs:label>
        <rdfs:label xml:lang="en">Penalty</rdfs:label>
        <rdfs:label xml:lang="el">Ποινή</rdfs:label>
        <rdfs:label xml:lang="bg">Наказание</rdfs:label>
        <rdfs:seeAlso rdf:resource="euvoc:penalty"/>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#person -->

    <owl:Class rdf:about="https://w3id.org/rrao#person">
        <rdfs:comment xml:lang="en">An individual, a human being perceptible through the senses and subject to physical laws</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <rdfs:label xml:lang="pt">Pessoa</rdfs:label>
        <rdfs:label xml:lang="el">Άτομο</rdfs:label>
        <rdfs:label xml:lang="bg">Лице</rdfs:label>
        <rdfs:seeAlso xml:lang="en">foaf:Person</rdfs:seeAlso>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#personWithCustodialHistory -->

    <owl:Class rdf:about="https://w3id.org/rrao#personWithCustodialHistory">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:comment xml:lang="en">A person who is or has been in custody charged with a criminal offense.</rdfs:comment>
        <rdfs:label xml:lang="pt">Indivíduo com historial de privação de liberdade</rdfs:label>
        <rdfs:label xml:lang="en">Person with custodial history</rdfs:label>
        <rdfs:label xml:lang="el">Άτομο με ιστορικό κράτησης</rdfs:label>
        <rdfs:label xml:lang="bg">Лице с история на задържане</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#prison -->

    <owl:Class rdf:about="https://w3id.org/rrao#prison">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#correctionaiInstitution"/>
        <rdfs:comment xml:lang="en">A secure facility where individuals are confined as punishment for crimes.</rdfs:comment>
        <rdfs:label xml:lang="en">Prison</rdfs:label>
        <rdfs:label xml:lang="pt">Prisão</rdfs:label>
        <rdfs:label xml:lang="el">Φυλακή</rdfs:label>
        <rdfs:label xml:lang="bg">Затвор</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#release -->

    <owl:Class rdf:about="https://w3id.org/rrao#release">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#executionOfPenalty"/>
        <rdfs:comment xml:lang="en">The act of freeing an individual from legal custody or imprisonment.</rdfs:comment>
        <rdfs:label xml:lang="pt">Libertação</rdfs:label>
        <rdfs:label xml:lang="en">Release</rdfs:label>
        <rdfs:label xml:lang="el">Αποφυλάκιση</rdfs:label>
        <rdfs:label xml:lang="bg">Освобождаване</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#released -->

    <owl:Class rdf:about="https://w3id.org/rrao#released">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:label xml:lang="pt">Libertado</rdfs:label>
        <rdfs:label xml:lang="en">Released</rdfs:label>
        <rdfs:label xml:lang="el">Αποφυλακισθείς</rdfs:label>
        <rdfs:label xml:lang="bg">Освободен</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#restraintOrders -->

    <owl:Class rdf:about="https://w3id.org/rrao#restraintOrders">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#wayOfRelease"/>
        <rdfs:comment xml:lang="en">A legal order restricting an individual from certain activities or contact with others.</rdfs:comment>
        <rdfs:label xml:lang="pt">Ordens de Restrição</rdfs:label>
        <rdfs:label xml:lang="en">Restraint orders</rdfs:label>
        <rdfs:label xml:lang="el">Περιοριστικοί όροι</rdfs:label>
        <rdfs:label xml:lang="bg">Ограничителни заповеди</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#riskOfReoffending -->

    <owl:Class rdf:about="https://w3id.org/rrao#riskOfReoffending">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rrao#High"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#Low"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#Medium"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The likelihood that an individual will reoffend or commit another crime after release.</rdfs:comment>
        <rdfs:label xml:lang="en">Reoffending Risk Assessment</rdfs:label>
        <rdfs:label xml:lang="pt">Risco de reincidência criminal</rdfs:label>
        <rdfs:label xml:lang="el">Κίνδυνος επανασυμμετοχής σε έγκλημα</rdfs:label>
        <rdfs:label xml:lang="bg">Риск от повторно извършване на престъпление</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#suspensionOfExecution -->

    <owl:Class rdf:about="https://w3id.org/rrao#suspensionOfExecution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#wayOfRelease"/>
        <rdfs:comment xml:lang="en">A delay or postponement of the enforcement of a legal penalty.</rdfs:comment>
        <rdfs:label xml:lang="en">Suspension of execution (Parole)</rdfs:label>
        <rdfs:label xml:lang="pt">Suspensão da execução da pena (liberdade condicional)</rdfs:label>
        <rdfs:label xml:lang="el">Αναστολή εκτέλεσης ποινής (Υφ’ όρον απόλυση)</rdfs:label>
        <rdfs:label xml:lang="bg">Отлагане на изпълнението (условно осъждане)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#termsImposedUponRelease -->

    <owl:Class rdf:about="https://w3id.org/rrao#termsImposedUponRelease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#wayOfRelease"/>
        <rdfs:comment xml:lang="en">Specific conditions or restrictions placed on an individual upon their release from custody.</rdfs:comment>
        <rdfs:label xml:lang="pt">Condições impostas aquando da libertação</rdfs:label>
        <rdfs:label xml:lang="en">Terms imposed upon release</rdfs:label>
        <rdfs:label xml:lang="el">Όροι επιβαλλόμενοι κατά την αποφυλάκιση</rdfs:label>
        <rdfs:label xml:lang="bg">Условия, наложени при освобождаването</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rrao#wayOfRelease -->

    <owl:Class rdf:about="https://w3id.org/rrao#wayOfRelease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rrao#executionOfPenalty"/>
