<?xml version="1.0"?>
<rdf:RDF xmlns="http://i-lab.aegean.gr/ontologies/rrao#"
     xml:base="http://i-lab.aegean.gr/ontologies/rrao"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:wot="http://xmlns.com/wot/0.1/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/spec/"
     xmlns:odrl="https://www.w3.org/ns/odrl/2/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rrao="https://w3id.org/rrao#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:eurovoc="http://publications.europa.eu/resource/authority/eurovoc/">
    <owl:Ontology rdf:about="https://w3id.org/rrao">
        <owl:imports rdf:resource="http://i-lab.aegean.gr/ontologies/rrao/iccs#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/odrl/2/"/>
        <dc:bibliographicCitation xml:lang="en">FAIR-PReSONS EU JUST project, Reoffending Risk Assesment Ontology,  Revision: v0.5.</dc:bibliographicCitation>
        <dc:contributor xml:lang="en">A. Sykiotou, Democritus University of Thace, asikioto@law.duth.gr</dc:contributor>
        <dc:contributor xml:lang="en">Joana Pinho, IPS, joana.pinho@prisonsystems.eu</dc:contributor>
        <dc:creator xml:lang="en">K. Kotis, i-lab, University of the Aegean, kotis@aegean.gr</dc:creator>
        <dc:creator xml:lang="en">S. Angelis, i-lab, University of the Aegean, sotiris@aegean.gr</dc:creator>
        <dc:description xml:lang="en">RRAO focuses on the comprehensive representation of knowledge of reoffending and related concepts such as, crime, penalty, court decision.
The ontology development is part of the FAIR – PReSONS research project.  https://fair-presons.aegean.gr/</dc:description>
        <dc:licence xml:lang="en">CC0</dc:licence>
        <dc:references xml:lang="en">eurovoc: https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/eurovoc</dc:references>
        <dc:references xml:lang="en">https://i-lab.aegean.gr/kotis/Ontologies/RRAO/iccs.owl</dc:references>
        <dc:references xml:lang="en">odrl:https://www.w3.org/ns/odrl/2/</dc:references>
        <dc:title xml:lang="en">Reoffending Risk Assessment Ontology</dc:title>
        <vann:preferredNamespacePrefix xml:lang="en">rrao</vann:preferredNamespacePrefix>
        <rdfs:label xml:lang="en">Reoffending Risk Assessment Ontology</rdfs:label>
        <rdfs:seeAlso xml:lang="en"></rdfs:seeAlso>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.1</owl:versionInfo>
        <ns:term_status xml:lang="en"></ns:term_status>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/bibliographicCitation -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/elements/1.1/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/licence -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/licence"/>
    


    <!-- http://purl.org/dc/elements/1.1/references -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/references"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://www.w3.org/2003/06/sw-vocab-status/ns#term_status -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/06/sw-vocab-status/ns#term_status"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#monetary -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#monetary"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/rrao#concerns -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#concerns">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#detentionRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#decides -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#decides">
        <rdfs:domain rdf:resource="https://w3id.org/rrao#court"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#courtDecision"/>
        <rdfs:label xml:lang="pt">decide</rdfs:label>
        <rdfs:label xml:lang="en">decides</rdfs:label>
        <rdfs:label xml:lang="el">αποφασίζει</rdfs:label>
        <rdfs:label xml:lang="bg">решава</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#defines -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#defines">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#courtDecision"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:comment xml:lang="en">Represents a court defining or establishing a penalty for a case.</rdfs:comment>
        <rdfs:label xml:lang="pt">define</rdfs:label>
        <rdfs:label xml:lang="en">defines</rdfs:label>
        <rdfs:label xml:lang="el">ορίζει</rdfs:label>
        <rdfs:label xml:lang="bg">определя</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#detainedAt -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#detainedAt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#correctionaiInstitution"/>
        <rdfs:comment xml:lang="en">Indicates the correctional facility where an person kept in custody.</rdfs:comment>
        <rdfs:label xml:lang="en">detained at</rdfs:label>
        <rdfs:label xml:lang="pt">detido em</rdfs:label>
        <rdfs:label xml:lang="el">κρατείται σε</rdfs:label>
        <rdfs:label xml:lang="bg">задържан в</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#executedAs -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#executedAs">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#executionOfPenalty"/>
        <rdfs:comment xml:lang="en">Indicates the manner in which a penalty or punishment is carried out.</rdfs:comment>
        <rdfs:label xml:lang="pt">executado como</rdfs:label>
        <rdfs:label xml:lang="en">executed as</rdfs:label>
        <rdfs:label xml:lang="el">εκτελείται ως</rdfs:label>
        <rdfs:label xml:lang="bg">изпълнено като</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#hasGravity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#hasGravity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#crime"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#gravityOfCrime"/>
        <rdfs:comment xml:lang="en">Indicates the severity or seriousness of a crime.</rdfs:comment>
        <rdfs:label xml:lang="en">has gravity</rdfs:label>
        <rdfs:label xml:lang="pt">tem gravidade</rdfs:label>
        <rdfs:label xml:lang="el">έχει βαρύτητα</rdfs:label>
        <rdfs:label xml:lang="bg">има тежест</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#hasLevelOfParticipation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#hasLevelOfParticipation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#levelOfParticipation"/>
        <rdfs:comment xml:lang="en">Describes the level or degree of participation an offender had in a crime.</rdfs:comment>
        <rdfs:label xml:lang="en">has level of participation</rdfs:label>
        <rdfs:label xml:lang="pt">tem grau de autoria</rdfs:label>
        <rdfs:label xml:lang="el">έχει επίπεδο συμμετοχής</rdfs:label>
        <rdfs:label xml:lang="bg">има степен на участие</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#hasLiability -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#hasLiability">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#liability"/>
        <rdfs:comment xml:lang="en">Represents the level of legal responsibility or liability an offender holds.</rdfs:comment>
        <rdfs:label xml:lang="en">has liability</rdfs:label>
        <rdfs:label xml:lang="pt">tem responsabilidade</rdfs:label>
        <rdfs:label xml:lang="el">έχει ευθύνη</rdfs:label>
        <rdfs:label xml:lang="bg">носи отговорност</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#hasRiskOfReoffending -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#hasRiskOfReoffending">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#riskOfReoffending"/>
        <rdfs:comment xml:lang="en">Represents the assessed risk that an offender will reoffend or engage in criminal behavior again.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk of reoffending</rdfs:label>
        <rdfs:label xml:lang="pt">tem risco de reincidência criminal</rdfs:label>
        <rdfs:label xml:lang="el">έχει κίνδυνο υποτροπής</rdfs:label>
        <rdfs:label xml:lang="bg">има риск от повторно извършване на престъпление</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#hasStatus -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#hasStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#imprisoned"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#convictionStatus"/>
        <rdfs:comment xml:lang="en">Describes the current status of an offender in prison</rdfs:comment>
        <rdfs:label xml:lang="en">has status</rdfs:label>
        <rdfs:label xml:lang="pt">tem estatuto</rdfs:label>
        <rdfs:label xml:lang="el">έχει κατάσταση</rdfs:label>
        <rdfs:label xml:lang="bg">има статус</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#isRelatedToCrime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#isRelatedToCrime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#crime"/>
        <rdfs:comment xml:lang="en">Indicates the association between a penalty and a crime related to the case.</rdfs:comment>
        <rdfs:label xml:lang="pt">está relacionado com o crime</rdfs:label>
        <rdfs:label xml:lang="en">is related to crime</rdfs:label>
        <rdfs:label xml:lang="el">σχετίζεται με έγκλημα</rdfs:label>
        <rdfs:label xml:lang="bg">е свързано с престъпление</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#participatedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#participatedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#crime"/>
        <rdfs:comment xml:lang="en">Indicates that the offender participated in a crime.</rdfs:comment>
        <rdfs:label xml:lang="en">participated in</rdfs:label>
        <rdfs:label xml:lang="pt">participou</rdfs:label>
        <rdfs:label xml:lang="el">συμμετείχε σε</rdfs:label>
        <rdfs:label xml:lang="bg">участвал в </rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#relatesToCorrectionalInstitution -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#relatesToCorrectionalInstitution">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#detentionRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#correctionaiInstitution"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#relatesToPenalty -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#relatesToPenalty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#detentionRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#penalty"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rrao#sentencedTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rrao#sentencedTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:comment>Indicates the penalty to which an offender has been sentenced.</rdfs:comment>
        <rdfs:label xml:lang="pt">condenado a</rdfs:label>
        <rdfs:label xml:lang="en">sentenced to</rdfs:label>
        <rdfs:label xml:lang="el">καταδικάστηκε σε</rdfs:label>
        <rdfs:label xml:lang="bg">осъден на</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/rrao#ageEnteringPrison -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#ageEnteringPrison">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rrao#ageGroup"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#ageExitingPrison -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#ageExitingPrison">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/rrao#ageGroup"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#ageGroup -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#ageGroup">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rrao#detentionRecord"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The age group that the person belongs to.</rdfs:comment>
        <rdfs:label xml:lang="en">age group</rdfs:label>
        <rdfs:label xml:lang="pt">faixa etária</rdfs:label>
        <rdfs:label xml:lang="el">Ηλικιακή ομάδα</rdfs:label>
        <rdfs:label xml:lang="bg">възрастова група</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#amountOfPecuniaryPenalty -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#amountOfPecuniaryPenalty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#pecuniarySentence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#monetary"/>
        <rdfs:comment xml:lang="en">Specifies the monetary amount of the pecuniary penalty.</rdfs:comment>
        <rdfs:label xml:lang="en">amount of pecuniary penalty</rdfs:label>
        <rdfs:label xml:lang="pt">montante da pena pecuniária</rdfs:label>
        <rdfs:label xml:lang="el">Ποσό χρηματικής ποινής</rdfs:label>
        <rdfs:label xml:lang="bg">размер на имущественото наказание</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#beneficialCalculation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#beneficialCalculation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether beneficial calculation was applied to the penalty.</rdfs:comment>
        <rdfs:label xml:lang="en">beneficial calculation</rdfs:label>
        <rdfs:label xml:lang="pt">cálculo do cúmulo jurídico</rdfs:label>
        <rdfs:label xml:lang="el">Ευνοϊκός υπολογισμός</rdfs:label>
        <rdfs:label xml:lang="bg">намаляване на наказанието</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#birthYear -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#birthYear">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Specifies the birth year of a person.</rdfs:comment>
        <rdfs:label xml:lang="pt">ano de nascimento</rdfs:label>
        <rdfs:label xml:lang="en">birth year</rdfs:label>
        <rdfs:label xml:lang="el">Έτος γέννησης</rdfs:label>
        <rdfs:label xml:lang="bg">година на раждане</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#clildren -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#clildren">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the person has children.</rdfs:comment>
        <rdfs:label xml:lang="en">children</rdfs:label>
        <rdfs:label xml:lang="pt">filhos</rdfs:label>
        <rdfs:label xml:lang="el">Παιδιά</rdfs:label>
        <rdfs:label xml:lang="bg">деца</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#dateOfCrime -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#dateOfCrime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#crime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Represents the date on which the crime occurred.</rdfs:comment>
        <rdfs:label xml:lang="pt">data do crime</rdfs:label>
        <rdfs:label xml:lang="en">date of crime</rdfs:label>
        <rdfs:label xml:lang="el">Ημερομηνία εγκλήματος</rdfs:label>
        <rdfs:label xml:lang="bg">дата на извършване на престъплението</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#dateOfEnteringPrison -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#dateOfEnteringPrison">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#custodialPenalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Specifies the date when the individual entered prison.</rdfs:comment>
        <rdfs:label xml:lang="pt">data de entrada no estabelecimento prisional</rdfs:label>
        <rdfs:label xml:lang="en">date of entering prison</rdfs:label>
        <rdfs:label xml:lang="el">Ημερομηνία εισόδου στη φυλακή</rdfs:label>
        <rdfs:label xml:lang="bg">дата на влизане в затвора</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#dateOfExitingPrison -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#dateOfExitingPrison">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#custodialPenalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Indicates the date when the individual is expected to exit prison.</rdfs:comment>
        <rdfs:label xml:lang="pt">data de saída do estabelecimento prisional</rdfs:label>
        <rdfs:label xml:lang="en">date of exiting prison</rdfs:label>
        <rdfs:label xml:lang="el">Ημερομηνία εξόδου από τη φυλακή</rdfs:label>
        <rdfs:label xml:lang="bg">дата на излизане от затвора</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#dateOfRiskAssessment -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#dateOfRiskAssessment">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#riskOfReoffending"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">date of risk assessment</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#daysInCustody -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#daysInCustody">
        <rdfs:domain rdf:resource="https://w3id.org/rrao#custody"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">days in custody</rdfs:label>
        <rdfs:label xml:lang="pt">dias encarcerado(a)</rdfs:label>
        <rdfs:label xml:lang="el">Ημέρες κράτησης</rdfs:label>
        <rdfs:label xml:lang="bg">дни лишаване от свобода</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#daysSinceRelease -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#daysSinceRelease">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Indicates the days since the person has been released form prison</rdfs:comment>
        <rdfs:label xml:lang="en">days since release</rdfs:label>
        <rdfs:label xml:lang="pt">dias desde a libertação</rdfs:label>
        <rdfs:label xml:lang="el">Ημέρες από την αποφυλάκιση</rdfs:label>
        <rdfs:label xml:lang="bg">дни от освобождаването</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#decisionCode -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#decisionCode">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#courtDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the code or reference associated with a court decision.</rdfs:comment>
        <rdfs:label xml:lang="pt">código da decisão</rdfs:label>
        <rdfs:label xml:lang="en">decision code</rdfs:label>
        <rdfs:label xml:lang="el">Κωδικός απόφασης</rdfs:label>
        <rdfs:label xml:lang="bg">код на решението</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#decisionDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#decisionDate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#courtDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Indicates the date associated with a court decision.</rdfs:comment>
        <rdfs:label xml:lang="pt">data da decisão</rdfs:label>
        <rdfs:label xml:lang="en">decision date</rdfs:label>
        <rdfs:label xml:lang="el">Ημερομηνία απόφασης</rdfs:label>
        <rdfs:label xml:lang="bg">дата на решението</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#generalRegisterNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#generalRegisterNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Represents the general register number associated with an imprisoned person.</rdfs:comment>
        <rdfs:label xml:lang="en">general register number</rdfs:label>
        <rdfs:label xml:lang="pt">número de registo geral</rdfs:label>
        <rdfs:label xml:lang="el">Γενικός αριθμός μητρώου</rdfs:label>
        <rdfs:label xml:lang="bg">регистрационен номер</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#irrevocableConviction -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#irrevocableConviction">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the conviction is irrevocable.</rdfs:comment>
        <rdfs:label xml:lang="pt">condenação transitada em julgado</rdfs:label>
        <rdfs:label xml:lang="en">irrevocable conviction</rdfs:label>
        <rdfs:label xml:lang="el">Αμετάκλητη καταδίκη</rdfs:label>
        <rdfs:label xml:lang="bg">неотменима присъда</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#isFromConcersion -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#isFromConcersion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Specifies whether the penalty is the result of a conversion from another penalty.</rdfs:comment>
        <rdfs:label xml:lang="en">is from conversion</rdfs:label>
        <rdfs:label xml:lang="pt">é de conversão</rdfs:label>
        <rdfs:label xml:lang="el">Προέρχεται από μετατροπή</rdfs:label>
        <rdfs:label xml:lang="bg">е от преобразуване</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#isInitialSentence -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#isInitialSentence">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">is initial sentence</rdfs:label>
        <rdfs:label xml:lang="pt">é pena inicial</rdfs:label>
        <rdfs:label xml:lang="el">Είναι αρχική ποινή</rdfs:label>
        <rdfs:label xml:lang="bg">е първоначална присъда</rdfs:label>
        <rdfs:seeAlso xml:lang="en">Indicates whether the penalty is an initial sentence.</rdfs:seeAlso>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#levelOfEducation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#levelOfEducation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rrao#detentionRecord"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The highest degree or level of schooling that an individual has completed.</rdfs:comment>
        <rdfs:label xml:lang="en">level of education</rdfs:label>
        <rdfs:label xml:lang="pt">nível de escolaridade</rdfs:label>
        <rdfs:label xml:lang="el">Επίπεδο εκπαίδευσης</rdfs:label>
        <rdfs:label xml:lang="bg">ниво на образование</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://ilostat.ilo.org/methods/concepts-and-definitions/classification-education/"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#locatedIn -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#locatedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#court"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Denotes the physical location or address of a court.</rdfs:comment>
        <rdfs:label xml:lang="pt">localizado em</rdfs:label>
        <rdfs:label xml:lang="en">located in</rdfs:label>
        <rdfs:label xml:lang="el">Βρίσκεται σε</rdfs:label>
        <rdfs:label xml:lang="bg">се намира в </rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#maritalStatus -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#maritalStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rrao#detentionRecord"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The legal relationship status of an individual, such as single, married, or divorced.</rdfs:comment>
        <rdfs:label xml:lang="pt">estado civil</rdfs:label>
        <rdfs:label xml:lang="en">marital status</rdfs:label>
        <rdfs:label xml:lang="el">Οικογενειακή κατάσταση</rdfs:label>
        <rdfs:label xml:lang="bg">семейно положение</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#nationality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#nationality">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Represents the nationality or citizenship of a person.</rdfs:comment>
        <rdfs:label xml:lang="pt">nacionalidade</rdfs:label>
        <rdfs:label xml:lang="en">nationality</rdfs:label>
        <rdfs:label xml:lang="el">Υπηκοότητα</rdfs:label>
        <rdfs:label xml:lang="bg">националност</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#numberOfReleasesFromPrison -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#numberOfReleasesFromPrison">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Indicated the number of times a person has been released from prison</rdfs:comment>
        <rdfs:label xml:lang="en">number of releases from prison</rdfs:label>
        <rdfs:label xml:lang="pt">número de libertações do estabelecimento prisional</rdfs:label>
        <rdfs:label xml:lang="el">Αριθμός αποφυλακίσεων</rdfs:label>
        <rdfs:label xml:lang="bg">брой освобождавания от затвора</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#penaltyDuration -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#penaltyDuration">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Represents the duration for which the penalty is enforced.</rdfs:comment>
        <rdfs:label xml:lang="pt">duração da pena</rdfs:label>
        <rdfs:label xml:lang="en">penalty duration</rdfs:label>
        <rdfs:label xml:lang="el">Διάρκεια ποινής</rdfs:label>
        <rdfs:label xml:lang="bg">продължителност на наказанието</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#placeOfCrime -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#placeOfCrime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#crime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Represents the place on which the crime occurred.</rdfs:comment>
        <rdfs:label xml:lang="pt">local do crime</rdfs:label>
        <rdfs:label xml:lang="en">place of crime</rdfs:label>
        <rdfs:label xml:lang="el">Τόπος εγκλήματος</rdfs:label>
        <rdfs:label xml:lang="bg">място на извършване на престъплението</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#reoffendingRate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#reoffendingRate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#personWithCustodialHistory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Indicated the number of times the offender has commited a crime after release</rdfs:comment>
        <rdfs:label xml:lang="en">reoffending rate</rdfs:label>
        <rdfs:label xml:lang="pt">taxa de reincidência</rdfs:label>
        <rdfs:label xml:lang="el">Φορές επανασυμμετοχής σε έγκλημα</rdfs:label>
        <rdfs:label xml:lang="bg">брой извършени нови престъпления</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#reportedOccupation -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#reportedOccupation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/rrao#detentionRecord"/>
                    <rdf:Description rdf:about="https://w3id.org/rrao#person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The job or profession that an individual identifies as their primary occupation.</rdfs:comment>
        <rdfs:label xml:lang="pt">profissão declarada</rdfs:label>
        <rdfs:label xml:lang="en">reported occupation</rdfs:label>
        <rdfs:label xml:lang="el">Δηλωθέν επάγγελμα</rdfs:label>
        <rdfs:label xml:lang="bg">декларирана професия</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://ilostat.ilo.org/methods/concepts-and-definitions/classification-occupation/"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#resultedInViolatingTerms -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#resultedInViolatingTerms">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the imprisonment resulted in the violation of terms.</rdfs:comment>
        <rdfs:label xml:lang="en">resulted in violating terms</rdfs:label>
        <rdfs:label xml:lang="pt">resultou na violação de condições</rdfs:label>
        <rdfs:label xml:lang="el">Οδήγησε σε παραβίαση όρων</rdfs:label>
        <rdfs:label xml:lang="bg">довело до нарушаване на условията</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#resultsFromMulitpleCrimes -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#resultsFromMulitpleCrimes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates that the penalty reffers to a multiple crime sentence</rdfs:comment>
        <rdfs:label xml:lang="en">results from multiple crimes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#sex -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#sex">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Indicates the biological sex of a person.Indicates the biological sex of a person.</rdfs:comment>
        <rdfs:label xml:lang="en">sex</rdfs:label>
        <rdfs:label xml:lang="pt">sexo</rdfs:label>
        <rdfs:label xml:lang="el">Φύλο</rdfs:label>
        <rdfs:label xml:lang="bg">пол</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#siblings -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#siblings">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the person has sibling.</rdfs:comment>
        <rdfs:label>siblings</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#takenInAbsentia -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#takenInAbsentia">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#courtDecision"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the court decision was made in the absence of the individual.</rdfs:comment>
        <rdfs:label xml:lang="pt">decidido à revelia</rdfs:label>
        <rdfs:label xml:lang="en">taken in absentia</rdfs:label>
        <rdfs:label xml:lang="el">Δικάστηκε ερήμην</rdfs:label>
        <rdfs:label xml:lang="bg">задочно осъждане</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#timesOccured -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#timesOccured">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#crime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Represent the number of times a crime has occured</rdfs:comment>
        <rdfs:label xml:lang="en">times occured</rdfs:label>
        <rdfs:label xml:lang="pt">vezes ocorridas</rdfs:label>
        <rdfs:label xml:lang="el">Φορές που συνέβη</rdfs:label>
        <rdfs:label xml:lang="bg">брой извършени престъпления</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#vocationalQualifications -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#vocationalQualifications">
        <rdfs:domain rdf:resource="https://w3id.org/rrao#person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rrao#workTime -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/rrao#workTime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rrao#communityServiceWork"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Specifies the duration of time required for community service work.</rdfs:comment>
        <rdfs:label xml:lang="pt">tempo de trabalho</rdfs:label>
        <rdfs:label xml:lang="en">work time</rdfs:label>
        <rdfs:label xml:lang="el">Χρόνος εργασίας</rdfs:label>
        <rdfs:label xml:lang="bg">отработено време</rdfs:label>
    </owl:DatatypeProperty>
    


